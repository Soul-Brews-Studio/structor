# structor-lance (Python) — LanceDB replica of Structor's PocketBase stores + admin UI.
#
#   just            list recipes
#   just install    uv sync (creates .venv from uv.lock)
#   just serve      replica + admin on 127.0.0.1:8094 (launchd runs this at login)
#   just once       one pull for every target, then exit
#   just status     tables, row counts, last sync (direct read of lance_data_py/)
#
# Reads hit lance_data_py/<target>/ directly; sync / optimize / fts go through
# the admin API when it is running so only one process writes a table. The Bun
# edition is the same program on 8092 with its own lance_data/; the two never
# share a directory.

root := justfile_directory()
uv   := env_var_or_default("UV", "uv")
uvx  := env_var_or_default("UVX", "uvx")
http := env_var_or_default("STRUCTOR_LANCE_PY_HTTP", "127.0.0.1:8094")

sl := uv + " run --project " + root + " structor-lance"

default:
    @just --list --unsorted

install:
    {{uv}} sync --project {{root}}

# Run replica + admin in the foreground.
serve http=http:
    {{sl}} serve --http "{{http}}"

# Admin UI only, no sync loop (inspect a store without touching it).
serve-readonly http="127.0.0.1:8098":
    {{sl}} serve --no-sync --http "{{http}}"

# One pull for every target, then exit.
once *targets:
    {{sl}} once {{ if targets == "" { "" } else { "--targets " + targets } }}

check:
    {{uv}} run --project {{root}} ruff check src tests

test: check
    {{uv}} run --project {{root}} pytest -q

# --- backend, no browser -------------------------------------------------

targets:
    {{sl}} targets

status target="local":
    {{sl}} status --target "{{target}}"

tables target="local":
    {{sl}} tables --target "{{target}}"

schema table target="local":
    {{sl}} schema "{{table}}" --target "{{target}}"

# just rows events "role = 'user' AND iso_week = '2026-W37'" 20
rows table where="" limit="20" target="local":
    {{sl}} rows "{{table}}" --where "{{where}}" --limit "{{limit}}" --target "{{target}}"

# Full-text search over events.text (LanceDB FTS index).
search query limit="20" target="local":
    {{sl}} search "{{query}}" --limit "{{limit}}" --target "{{target}}"

# Rows on the PocketBase side vs rows here, per table.
lag target="local":
    {{sl}} lag --target "{{target}}"

# Pull now (through the admin API when it is up).
sync target="local":
    {{sl}} sync --target "{{target}}"

# Compact fragments and index rows added since the FTS index was built.
optimize table="events" target="local":
    {{sl}} optimize "{{table}}" --target "{{target}}"

# Rebuild the full-text index on events.text.
fts target="local":
    {{sl}} fts --target "{{target}}"

# --- vectors: optional, FTS stays the default ----------------------------
#
# Needs an Ollama pool: ~/.config/structor/lance.json
#   {"ollama_urls": ["http://gpu1:11434", "http://gpu2:11434"], "embedding_model": "bge-m3"}
# or STRUCTOR_OLLAMA_URLS=http://gpu1:11434,http://gpu2:11434. Without one,
# embed and vsearch exit 78 and everything else carries on.
#
# The space is bge-m3 / 1024 / cosine over text[:2000] — lanceglass's space, so
# vectors from either tool are comparable. 68 rows/s on one RTX 4090, ~2x on
# two; this store's ~94k conversational rows take about 12 minutes on the pair.

# Fill event_vectors from the conversational events, newest first. Resumable.
embed limit="" batch="128" where="" target="local":
    {{sl}} embed {{ if limit == "" { "" } else { "--limit " + limit } }} --batch "{{batch}}" --where "{{where}}" --target "{{target}}"

# Nearest events to a query. mode = vector | hybrid (vector + FTS, RRF-fused).
vsearch query limit="20" mode="vector" target="local":
    {{sl}} vsearch "{{query}}" --limit "{{limit}}" --mode "{{mode}}" --target "{{target}}"

# Rows embedded, rows still pending.
vectors target="local":
    {{sl}} vectors --target "{{target}}"

# --- the wiki: the maintainers' markdown, in the same store ---------------
#
# One directory per replica. Re-running is cheap: a section whose text hash is
# unchanged is never sent to the pool, so only edits cost GPU time — which is
# also why `just wiki` reports the last text change and not the last touch.

# Index every *.md under dir into the wiki table. With no dir, the CLI uses
# wiki_dir from ~/.config/structor/lance.json (or STRUCTOR_WIKI_DIR).
wiki-index dir="" target="local":
    {{sl}} wiki-index {{ if dir == "" { "" } else { quote(dir) } }} --target "{{target}}"

# Search the wiki sections. mode = hybrid | vector | fts.
wiki-search q mode="hybrid" limit="10" target="local":
    {{sl}} wiki-search "{{q}}" --mode "{{mode}}" --limit "{{limit}}" --target "{{target}}"

# Rows, distinct files, newest last text change (a touched file keeps its stamp).
wiki target="local":
    {{sl}} wiki --target "{{target}}"

open:
    open "http://{{http}}/"

# The old PocketBase console pages, served by this process over the replica.
open-console target="local":
    open "http://{{http}}/console/{{target}}/"

api path="/api/status":
    curl -s "http://{{http}}{{path}}" | python3 -m json.tool | head -80

# Grounded answer from the transcripts: retrieve (hybrid), generate on the chat host (gpu2), cite sources.
# just ask "how does the tray start at login?" 8
ask question k="8" target="local":
    uv run structor-lance ask "{{question}}" --k "{{k}}" --target "{{target}}"

# --- the live page, recorded ---------------------------------------------
#
# /live.html on this process, captured as WebM + GIF by ../scripts/record-live.py:
# Playwright from uvx drives the system Chrome headless (bundled Chromium after
# `uvx --with playwright playwright install chromium`), one screenshot per
# 1/fps second, then ffmpeg. Relative paths resolve from this directory; the
# default drops the clip in ../recordings/ (gitignored). The tour's clip is
#   just record out=../../docs/structor-tour/images name=12-live-jsonl

# Record /live.html as <out>/<name>.webm + .gif (Playwright via uvx, system Chrome, ffmpeg).
record url=("http://" + http + "/live.html?target=local&mode=replay&minutes=180&speed=60&seconds=18") seconds="20" fps="4" out=(root + "/../recordings") name="live-jsonl":
    {{uvx}} --with playwright python {{root}}/../scripts/record-live.py --url "{{url}}" --seconds "{{seconds}}" --fps "{{fps}}" --out "{{out}}" --name "{{name}}"

# What `just record` would run, without a browser: viewport, frame count, the ffmpeg commands.
record-plan url=("http://" + http + "/live.html?target=local&mode=replay"):
    {{root}}/.venv/bin/python {{root}}/../scripts/record-live.py --url "{{url}}" --dry-run | python3 -m json.tool
